# ── Required ────────────────────────────────────────────────────────────────
GROQ_API_KEY=
TURSO_URL=libsql://your-db.turso.io
TURSO_TOKEN=
QDRANT_URL=
QDRANT_API_KEY=

# ── Auth (the server will not start without at least one key, unless auth is disabled) ──
NEXUS_API_KEY=            # user level: chat, reading data, ticket status and comments
NEXUS_ADMIN_API_KEY=      # admin level: employee edits, leave decisions, ticket deletes, KB management
# NEXUS_AUTH_DISABLED=true  # local development only: opens every route
CORS_ORIGINS=http://localhost:5173

# ── Optional ────────────────────────────────────────────────────────────────
# GROQ_MODEL=openai/gpt-oss-120b
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# AUTO_RESOLVE_THRESHOLD=0.72
# SLA_HOURS=24
# AUTO_APPROVE_LEAVE_DAYS=2
# NEXUS_ENABLE_SCHEDULER=true
# SLA_SWEEP_MINUTES=30
# DIGEST_HOUR=9

# Slack (the /slack/events endpoint stays disabled until SLACK_SIGNING_SECRET is set)
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_DIGEST_CHANNEL=
